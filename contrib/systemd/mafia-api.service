[Unit]
Description=MAFIA FastAPI service
Documentation=https://github.com/frostyard/mafia
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mafia
Group=mafia
WorkingDirectory=/opt/mafia/current
Environment=HOME=/var/lib/mafia
EnvironmentFile=/etc/mafia/mafia.env
ExecStart=/opt/mafia/current/bin/api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/mafia

[Install]
WantedBy=mafia.target
