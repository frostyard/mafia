MAFIA_DATA_DIR=/var/lib/mafia/data
MAFIA_API_HOST=127.0.0.1
MAFIA_API_PORT=8000
MAFIA_API_URL=http://127.0.0.1:8000
MAFIA_WEB_HOST=127.0.0.1
MAFIA_WEB_PORT=3000

MAFIA_AUTH_MODE=github
MAFIA_GITHUB_OAUTH_CLIENT_ID=
MAFIA_GITHUB_OAUTH_CLIENT_SECRET=
MAFIA_GITHUB_OAUTH_CALLBACK_URL=https://mafia-frostyard.example-tailnet.ts.net/auth/callback
MAFIA_GITHUB_SESSION_SECRET=
MAFIA_INTERNAL_SECRET=
MAFIA_GITHUB_ALLOWED_ORG=frostyard
MAFIA_GITHUB_SESSION_HOURS=12

MAFIA_REPOSITORY_OWNER=frostyard
MAFIA_GITHUB_APP_ID=
MAFIA_GITHUB_APP_INSTALLATION_ID=
MAFIA_GITHUB_APP_PRIVATE_KEY_PATH=/etc/mafia/github-app.pem
MAFIA_REPOSITORY_ACTION_NAME=Frostyard-MAFIA
MAFIA_REPOSITORY_ACTION_EMAIL=mafia-frostyard[bot]@users.noreply.github.com

# Execution mode is configured per project, not through this environment file.
MAFIA_CONTAINER_ENGINE=podman
MAFIA_DEVCONTAINER_POLICY=strict
MAFIA_DEVCONTAINER_NETWORK=setup-only
MAFIA_CONTAINER_CPU_LIMIT=4
MAFIA_CONTAINER_MEMORY_LIMIT=4g
MAFIA_SANDBOX_PROCESS_LIMIT=128

MAFIA_MODEL_PAIRS={"claude-opus-4.8":"gpt-5.6-sol","gpt-5.6-sol":"claude-opus-4.8"}
