MAFIA_DATA_DIR=./data
MAFIA_API_HOST=127.0.0.1
MAFIA_API_PORT=8000
MAFIA_API_URL=http://127.0.0.1:8000
MAFIA_WEB_HOST=127.0.0.1
MAFIA_WEB_PORT=3000
# GitHub OAuth is opt-in. When enabled, configure at least one allowed immutable
# user ID or an allowed organization; unrestricted GitHub access is not supported.
MAFIA_AUTH_MODE=disabled
# MAFIA_GITHUB_OAUTH_CLIENT_ID=
# MAFIA_GITHUB_OAUTH_CLIENT_SECRET=
# MAFIA_GITHUB_OAUTH_CALLBACK_URL=https://mafia.example.com/auth/callback
# MAFIA_GITHUB_SESSION_SECRET=
# MAFIA_INTERNAL_SECRET=
# MAFIA_GITHUB_ALLOWED_USER_IDS=[37492]
# MAFIA_GITHUB_ALLOWED_ORG=frostyard
# MAFIA_GITHUB_SESSION_HOURS=12
MAFIA_MERGE_POLL_SECONDS=30
MAFIA_SANDBOX_PROCESS_LIMIT=128
MAFIA_EXECUTION_MODE=isolated
MAFIA_CONTAINER_ENGINE=auto
MAFIA_DEVCONTAINER_CLI_PATH=devcontainer
MAFIA_DEVCONTAINER_POLICY=strict
MAFIA_DEVCONTAINER_NETWORK=setup-only
MAFIA_DEVCONTAINER_SETUP_TIMEOUT_SECONDS=1800
MAFIA_CONTAINER_CPU_LIMIT=4
MAFIA_CONTAINER_MEMORY_LIMIT=4g
# JSON object mapping each selectable primary/adjudicator model to its reviewer.
MAFIA_MODEL_PAIRS={"claude-opus-4.8":"gpt-5.6-sol","gpt-5.6-sol":"claude-opus-4.8"}
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=/api/copilotkit
AGENT_URL=http://127.0.0.1:8000/ag-ui
COPILOTKIT_TELEMETRY_DISABLED=true
