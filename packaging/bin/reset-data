#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${1:-}" != "--confirm-destructive-reset" ]]; then
  printf 'Refusing to delete runtime data without --confirm-destructive-reset.\n' >&2
  exit 2
fi

: "${MAFIA_DATA_DIR:?Set MAFIA_DATA_DIR to the runtime data directory}"

target="$(realpath -m -s -- "$MAFIA_DATA_DIR")"
current="$(pwd -P)"
parent="$(dirname -- "$current")"
case "$target" in
  /|"$current"|"$parent")
    printf 'Refusing unsafe MAFIA_DATA_DIR: %s\n' "$MAFIA_DATA_DIR" >&2
    exit 2
    ;;
esac

# Never traverse a symlink while choosing the directory to remove.
probe="$target"
while [[ ! -e "$probe" && ! -L "$probe" ]]; do
  probe="$(dirname -- "$probe")"
done
if [[ "$(realpath -e -- "$probe")" != "$(realpath -m -s -- "$probe")" ]]; then
  printf 'Refusing symlinked MAFIA_DATA_DIR: %s\n' "$MAFIA_DATA_DIR" >&2
  exit 2
fi

# Module caches can contain read-only directories. Recursive chmod ignores symlinks
# it encounters, so descendants cannot lead outside the already-validated target.
if [[ -e "$target" ]]; then
  chmod -R u+w -- "$target"
fi
rm -rf -- "$target"
install -d -m 0750 -- "$target"
